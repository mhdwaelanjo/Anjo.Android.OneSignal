<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net7.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.OneSignal.Notifications</PackageId>
		<PackageVersion>5.1.12</PackageVersion>
		<AssemblyVersion>5.1.12</AssemblyVersion>
		<FileVersion>5.1.12</FileVersion>
		<Version>5.1.12</Version>
		<Title>Anjo Android OneSignal.Notifications SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.OneSignal</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - OneSignal.Notifications SDK</Description>
		<PackageReleaseNotes>OneSignal.Notifications SDK v5.1.12</PackageReleaseNotes>
		<Copyright>Copyright (c) 2024 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, NET MAUI, OneSignal, push notification</PackageTags>
		<Summary>OneSignal is a free email, sms, push notification, and in-app message service for mobile apps. This plugin makes it easy to integrate your native Android or Amazon app with OneSignal.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\notifications-5.1.12.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.9.0" />
	  <PackageReference Include="Xamarin.Firebase.Messaging" Version="123.3.1.1" />
	  <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.2.0.5" />
	  <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.22" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.7.3.3" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.7.3.3" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Anjo.Android.OneSignal.Core\Anjo.Android.OneSignal.Core.csproj" />
	</ItemGroup>
</Project>