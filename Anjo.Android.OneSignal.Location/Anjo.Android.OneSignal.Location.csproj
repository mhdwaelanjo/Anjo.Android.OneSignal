<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.OneSignal.Location</PackageId>
		<PackageVersion>5.0.2</PackageVersion>
		<AssemblyVersion>5.0.2</AssemblyVersion>
		<FileVersion>5.0.2</FileVersion>
		<Version>5.0.2</Version>
		<Title>Anjo Android OneSignal.Location SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.OneSignal</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - OneSignal.Location SDK</Description>
		<PackageReleaseNotes>OneSignal.Location SDK v5.0.2</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, OneSignal, push notification</PackageTags>
		<Summary>OneSignal is a free email, sms, push notification, and in-app message service for mobile apps. This plugin makes it easy to integrate your native Android or Amazon app with OneSignal.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Jars\location-5.0.2.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.10.1" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.7.3.1" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.7.3.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Anjo.Android.OneSignal.Core\Anjo.Android.OneSignal.Core.csproj" />
		<ProjectReference Include="..\Anjo.Android.OneSignal.Notifications\Anjo.Android.OneSignal.Notifications.csproj" />
	</ItemGroup>
</Project>